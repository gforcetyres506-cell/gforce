# Runtime mode (server-only configuration)
# Fictional runtime records are retired. Production MUST use false.
APP_ENV=development
ENABLE_MOCK_DATA=false

# Public contact UI. Set only owner-approved business numbers in international
# format (leading + and country code). Blank/invalid values hide each action.
# WhatsApp is configured independently. Redeploy after changing these values
# so prerendered pages receive the new configuration. Never copy seed settings.
BUSINESS_PHONE=
BUSINESS_WHATSAPP=

# Supabase public browser configuration (production-required, public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase privileged access (production-required, server-only)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (production-required; publishable key is public, other values server-only)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (production-required, server-only)
RESEND_API_KEY=
EMAIL_FROM="G Force Tyres <bookings@yourdomain.co.uk>"

# Vehicle data (production-required, server-only)
ONEAUTO_API_KEY=
ONEAUTO_BASE_URL=https://api.oneautoapi.com

# Bot protection (production-required; site key is public, secret is server-only)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# VRM cache encryption (production-required, server-only; minimum 32 characters)
VRM_CACHE_ENCRYPTION_KEY=

# Canonical site URL (production-required, server-only)
APP_URL=http://localhost:3000

# Legacy compatibility only; migrate consumers to APP_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
